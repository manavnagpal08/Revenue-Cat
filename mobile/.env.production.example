# ==============================================================================
# SoloCEO Mobile Production Environment Variables
# ==============================================================================

# Supabase Public Client Credentials (Anon key only)
EXPO_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-production-supabase-anon-key

# Production Backend HTTPS Endpoint
EXPO_PUBLIC_API_URL=https://api.soloceo.com

# RevenueCat Public SDK API Keys
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_production_apple_public_key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_production_google_public_key
