# ==============================================================================
# SoloCEO Mobile Development Environment Variables
# ==============================================================================

# Supabase Public Client Credentials (NO service role keys here)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API URL (for local dev: http://localhost:8000 or http://10.0.2.2:8000 on Android emulator)
EXPO_PUBLIC_API_URL=http://localhost:8000

# RevenueCat Public SDK API Keys
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=appl_your_apple_public_key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=goog_your_google_public_key
