# ==============================================================================
# SoloCEO Production Backend Environment Configuration
# ==============================================================================

# Server Runtime Settings
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=https://app.soloceo.com,https://api.soloceo.com

# Supabase Production Database & Auth
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# AI Intelligence Providers (At least one required)
GEMINI_API_KEY=your-production-gemini-api-key
OPENAI_API_KEY=your-production-openai-api-key
DEFAULT_AI_PROVIDER=gemini # or 'openai'

# External Integrations (Optional until configured)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://api.soloceo.com/api/integrations/google/callback
META_WHATSAPP_PHONE_NUMBER_ID=your-meta-whatsapp-phone-id
META_WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-access-token
META_WHATSAPP_VERIFY_TOKEN=your-meta-webhook-verify-token

# RevenueCat Monetization & Entitlements
REVENUECAT_API_KEY=your-production-revenuecat-secret-api-key
REVENUECAT_WEBHOOK_SECRET=your-production-revenuecat-webhook-secret

# Security & Session Verification
JWT_SECRET=your-cryptographically-secure-256-bit-production-jwt-secret
SESSION_EXPIRY_HOURS=720 # 30 days persistent session
